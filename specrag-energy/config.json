{
  "gpu_index": 0,
  "server_host": "127.0.0.1",
  "server_port": 8765,
  "models": {
    "drafter": "Qwen/Qwen2.5-0.5B-Instruct",
    "verifier": "Qwen/Qwen2.5-1.5B-Instruct",
    "embedder": "KomeijiForce/inbedder-roberta-large",
    "dtype": "bfloat16",
    "attn_implementation": "sdpa"
  },
  "generation": {
    "max_new_tokens": 128,
    "greedy": true,
    "prefill": "## Rationale:",
    "one_shot": true
  },
  "retrieval": {
    "R": 10,
    "ctx_mode": "scored_only"
  },
  "speculative": {
    "m_levels": [
      2,
      5,
      10
    ],
    "k_levels": [
      1,
      2,
      4
    ],
    "reflection_statement": "Do you think the explanation supports the answers? (Yes or No)",
    "kmeans_n_init": 10,
    "embed_n_mask": 3
  },
  "sampling": {
    "questions_per_benchmark": 30,
    "warmup_questions_per_benchmark": 5,
    "seed": 2026
  },
  "data": {
    "pubhealth_raw": "data/raw/eval_datasets/PubHealth/health_claims_processed.jsonl",
    "triviaqa_raw": "data/raw/eval_datasets/TriviaQA/triviaqa_test_w_gs.jsonl",
    "prepared_dir": "data/prepared"
  },
  "experiment": {
    "repetitions": 10,
    "cooldown_ms": 30000,
    "warmup_queries": 10,
    "thermal_gate_enabled": true,
    "thermal_gate_max_temp_c": 55,
    "thermal_gate_margin_c": 3,
    "thermal_gate_timeout_s": 120,
    "power_sample_period_s": 0.1,
    "request_timeout_s": 600
  },
  "cpu_energy_model": {
    "tdp_w": 125,
    "idle_w": 0
  },
  "cpu_energy": {
    "method": "energibridge",
    "binary": "energibridge",
    "interval_ms": 50,
    "startup_s": 1.0
  }
}
